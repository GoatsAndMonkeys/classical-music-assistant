  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Ja linnoista suurin ja kaunein, ja myös vanhin, on Vyšehrad.\"",
   "primary": null,
   "sort-name": "Moldau: \"Ja linnoista suurin ja kaunein, ja myös vanhin, on Vyšehrad.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Joenpoikanen kasvaa joeksi.\"",
   "primary": null,
   "sort-name": "Moldau: \"Joenpoikanen kasvaa joeksi.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Josstain Moldaun rantametsikötä kuuluu äkkiä metsästystorven kaikuja.\"",
   "primary": null,
   "sort-name": "Moldau: \"Josstain Moldaun rantametsikötä kuuluu äkkiä metsästystorven kaikuja.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Kaikki on vaiti hiljaisessa yössä.\"",
   "primary": null,
   "sort-name": "Moldau: \"Kaikki on vaiti hiljaisessa yössä.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Kaukaa kuuluu musiikkia. Kylästä, jonka Moldau ohittaa, soivat polkan sävelet: kylässä on häät.\"",
   "primary": null,
   "sort-name": "Moldau: \"Kaukaa kuuluu musiikkia. Kylästä, jonka Moldau ohittaa, soivat polkan sävelet: kylässä on häät.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Kivenjärkäleet ja kalliot vaikeuttavat veden kulkua.\"",
   "primary": null,
   "sort-name": "Moldau: \"Kivenjärkäleet ja kalliot vaikeuttavat veden kulkua.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Lopultakin tie on audi, ja Moldau virtaa leveänä tasangolle.\"",
   "primary": null,
   "sort-name": "Moldau: \"Lopultakin tie on audi, ja Moldau virtaa leveänä tasangolle.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Moldau jättää hyvästit Prahalle.\"",
   "primary": null,
   "sort-name": "Moldau: \"Moldau jättää hyvästit Prahalle.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Moldau on virta. Se on virtaavaa vettä.\"",
   "primary": null,
   "sort-name": "Moldau: \"Moldau on virta. Se on virtaavaa vettä.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Virta alkaa lähteestään.\"",
   "primary": null,
   "sort-name": "Moldau: \"Virta alkaa lähteestään.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Vyšehradin linnan jälkeen Moldau halkaisee keseltä Tšekkoslovakian pääkaupungin.\"",
   "primary": null,
   "sort-name": "Moldau: \"Vyšehradin linnan jälkeen Moldau halkaisee keseltä Tšekkoslovakian pääkaupungin.\"",
   "type": null,
   "type-id": null
  },
  {
   "begin": null,
   "end": null,
   "ended": false,
   "locale": null,
   "name": "Moldau: \"Yö on mennyt.\"",
